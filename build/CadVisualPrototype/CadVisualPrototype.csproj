<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 仅用于授权 CAD 原型，不加入产品解决方案或发布载荷。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblySearchPaths>{HintPathFromItem};$(AutoCadManagedRoot);{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.34</Version>
    <AssemblyVersion>0.1.34.0</AssemblyVersion>
    <FileVersion>0.1.34.0</FileVersion>
    <AssemblyName>Pn3DKit.VisualPrototype</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCadManagedRoot)/AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCadManagedRoot)/AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCadManagedRoot)/AcMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
