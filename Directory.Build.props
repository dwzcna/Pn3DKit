<Project>
  <PropertyGroup>
    <!-- 产品支持三段或用户指定的四段补丁版本，程序集与文件版本始终四段。 -->
    <Version>0.1.47</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyVersion Condition="$([System.String]::Copy('$(Version)').Split('.').Length) == 3">$(Version).0</AssemblyVersion>
    <AssemblyVersion Condition="$([System.String]::Copy('$(Version)').Split('.').Length) == 4">$(Version)</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 按配置和平台隔离 NuGet 还原图，避免 Debug/Release 互相覆盖。 -->
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\restore\$(Configuration)\$(Platform)\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
