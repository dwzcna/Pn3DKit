<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- AutoCAD 2026 使用 .NET 8 宿主；插件不携带独立运行时。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <Plant3DSdkRoot Condition="'$(Plant3DSdkRoot)' == ''">E:\AutoCAD Plant 3D 2026 SDK</Plant3DSdkRoot>
    <!-- 默认优先读取本机 CAD 的参考；可显式指定已验证的 .NET 8 SDK 目录。 -->
    <AutoCadManagedRoot Condition="'$(AutoCadManagedRoot)' == '' and Exists('$(ProgramW6432)\Autodesk\AutoCAD 2026\AcCoreMgd.dll')">$(ProgramW6432)\Autodesk\AutoCAD 2026</AutoCadManagedRoot>
    <AutoCadManagedRoot Condition="'$(AutoCadManagedRoot)' == ''">$(Plant3DSdkRoot)\inc</AutoCadManagedRoot>
    <PlantManagedRoot Condition="'$(PlantManagedRoot)' == '' and Exists('$(AutoCadManagedRoot)\PLNT3D\PnPProjectManagerMgd.dll')">$(AutoCadManagedRoot)\PLNT3D</PlantManagedRoot>
    <PlantManagedRoot Condition="'$(PlantManagedRoot)' == ''">$(Plant3DSdkRoot)\inc-x64</PlantManagedRoot>
  </PropertyGroup>
  <!-- Autodesk 程序集由 CAD 提供，严禁复制进 NETLOAD 交付目录。 -->
  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCadManagedRoot)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCadManagedRoot)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCadManagedRoot)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AutoCadManagedRoot)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcWindows">
      <HintPath>$(AutoCadManagedRoot)\AcWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PnPProjectManagerMgd">
      <HintPath>$(PlantManagedRoot)\PnPProjectManagerMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PnPDataLinks">
      <HintPath>$(PlantManagedRoot)\PnPDataLinks.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PnPDataObjects">
      <HintPath>$(PlantManagedRoot)\PnPDataObjects.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PnPCommonDbxMgd">
      <HintPath>$(PlantManagedRoot)\PnPCommonDbxMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidatePlantSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AutoCadManagedRoot)\AcCoreMgd.dll') or !Exists('$(PlantManagedRoot)\PnPProjectManagerMgd.dll')" Text="缺少 AutoCAD/Plant 3D 2026 的 .NET 8 参考程序集，请设置 AutoCadManagedRoot、PlantManagedRoot 或 Plant3DSdkRoot。" />
    <Error Condition="'$(Platform)' == 'ARM64'" Text="Pn3DKit 仅支持 AutoCAD 2026 x64。" />
  </Target>
</Project>
