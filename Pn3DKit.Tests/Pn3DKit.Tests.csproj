<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 测试与 CAD 宿主同为 .NET 8，不引用或加载 Autodesk 程序集。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <Using Include="Xunit" />
    <!-- WPF SDK 不默认导入 System.IO，链接的离线日志策略仍需该命名空间。 -->
    <Using Include="System.IO" />
    <!-- 链接插件同一份策略源码，使用离线宿主验证文档生命周期。 -->
    <!-- 纯 WPF 视图离线烟测，无 CAD 连接或 Autodesk 引用。 -->
    <Compile Include="../Pn3DKit/UI/FastPropertiesView.cs" Link="UI/FastPropertiesView.cs" />
    <Compile Include="../Pn3DKit/Models/**/*.cs" Link="Models/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Pn3DKit/Services/**/*.cs" Link="Services/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Pn3DKit/Utils/**/*.cs" Link="Utils/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
